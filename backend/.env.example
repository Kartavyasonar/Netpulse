# NetPulse Environment Variables
# PRIMARY NODE — copy to .env and fill in your values

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://netpulse:netpulse_pass@localhost:5432/netpulse

# ── Security ─────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_64_CHAR_SECRET
ADMIN_USERNAME=admin
ADMIN_PASSWORD=netpulse2026

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=https://your-app.vercel.app

# ── Probing ───────────────────────────────────────────────────────────────────
PROBE_INTERVAL_SECONDS=60
DEFAULT_HOSTS=8.8.8.8,1.1.1.1,8.8.4.4,google.com,github.com,cloudflare.com

# ── Alerting ─────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password
ALERT_FROM_EMAIL=your@gmail.com
ALERT_TO_EMAIL=your@gmail.com
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# ── Change 1: Distributed nodes ──────────────────────────────────────────────
NODE_ROLE=primary
NODE_ID=primary-01
NODE_LABEL=Primary Node
NODE_REGION=ap-mumbai-1
# Shared secret between nodes — generate: openssl rand -hex 24
NODE_SECRET=CHANGE_THIS_NODE_SECRET
# URLs of peer probe nodes (comma-separated) — add after setting up probe nodes
PEER_NODE_URLS=

# ── Change 2: Dead-man's switch ──────────────────────────────────────────────
# No config needed — uses HEARTBEAT_INTERVAL_SECONDS=30, HEARTBEAT_MISS_THRESHOLD=3

# ── Change 3: Structured logging ─────────────────────────────────────────────
LOG_LEVEL=INFO
# Leave empty on primary. Set to primary VPS IP on probe nodes.
SYSLOG_HOST=
SYSLOG_PORT=514

# ── Change 4: Scapy pcap ─────────────────────────────────────────────────────
# Set to true on Linux VPS to enable pcap RTT delta measurement
PCAP_ENABLED=false
PCAP_INTERFACE=eth0

# ── Change 5: iptables ───────────────────────────────────────────────────────
IPTABLES_RATE_LIMIT=10


# ─────────────────────────────────────────────────────────────────────────────
# PROBE NODE .env (for your second Oracle VPS) — different values:
# NODE_ROLE=probe
# NODE_ID=frankfurt-01
# NODE_LABEL=Frankfurt Probe Node
# NODE_REGION=eu-frankfurt-1
# PRIMARY_INGEST_URL=https://your-primary-domain.com
# PEER_NODE_URLS=https://your-primary-domain.com
# SYSLOG_HOST=your-primary-vps-ip
# DATABASE_URL=postgresql+asyncpg://netpulse:netpulse_pass@localhost:5432/netpulse
